# StackLeo Tech Store — Root Environment Variable Reference
#
# This root .env.example documents shared, cross-cutting variables only.
# Each app (apps/web, apps/admin, apps/api) maintains its own .env.example
# for app-specific configuration. Never commit a real .env file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — consumed by apps/api via Prisma
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/stackleo_dev

# ---------------------------------------------------------------------------
# Cache / Session Store (Redis) — consumed by apps/api
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Shared Service URLs
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
