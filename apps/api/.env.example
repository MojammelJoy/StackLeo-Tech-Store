# StackLeo API — Environment Variables

NODE_ENV=development
PORT=4000

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://stackleo:stackleo@localhost:5432/stackleo_dev

# Cache / Session Store (Redis)
REDIS_URL=redis://localhost:6379

# Auth — JWT signing secrets (min 32 chars each). Generate real, distinct
# values per environment, e.g. `openssl rand -hex 32` — never reuse these
# example values outside local development.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-deploying-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-deploying-32c
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — allowed origins for the web and admin apps
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
