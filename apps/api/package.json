{
  "name": "@stackleo/api",
  "version": "0.1.0",
  "private": true,
  "description": "StackLeo Tech Store — backend REST API (Express + Prisma + PostgreSQL + Redis).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma"
  },
  "dependencies": {
    "express": "^4.19.0",
    "@prisma/client": "^5.14.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0",
    "pino": "^9.1.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "uuid": "^9.0.1",
    "@stackleo/types": "workspace:*",
    "@stackleo/utils": "workspace:*",
    "@stackleo/validation": "workspace:*",
    "@stackleo/constants": "workspace:*"
  },
  "devDependencies": {
    "@stackleo/config": "workspace:*",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "prisma": "^5.14.0",
    "tsx": "^4.10.0",
    "pino-pretty": "^11.0.0",
    "@types/express": "^4.17.0",
    "@types/express-serve-static-core": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/uuid": "^9.0.8"
  }
}
