# StackLeo API — Staging Environment Variables
#
# Copy to `.env.staging` and fill in real values; never commit the real
# file (see .gitignore). Consumed via docker-compose.staging.yml's
# `env_file: apps/api/.env.staging`.
#
# NODE_ENV is "production" here on purpose, not "staging" — src/config's
# env schema (src/config/env.schema.ts) only recognizes
# development/test/production; it has no separate "staging" value.
# Staging is distinguished from production by *which* DATABASE_URL/
# REDIS_URL/secrets it points at, not by a different NODE_ENV. Changing
# the schema to add a "staging" enum value would be an application-code
# change, out of scope for this deployment foundation.
NODE_ENV=production
PORT=4000

# Point these at your actual staging Postgres/Redis instances — never
# the same database production uses.
DATABASE_URL=postgresql://stackleo:CHANGE_ME@staging-db-host:5432/stackleo_staging
REDIS_URL=redis://staging-redis-host:6379

# Generate real, distinct values per environment — e.g. `openssl rand -hex 32`.
# Never reuse a development or production secret here.
JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allow only the staging web/admin origins — never a wildcard.
CORS_ALLOWED_ORIGINS=https://staging.stackleo.example,https://staging-admin.stackleo.example

LOG_LEVEL=info

# Media — local-disk storage (modules/media's LocalUploadProvider); see
# .env.production.example's comment on this same setting.
MEDIA_LOCAL_STORAGE_DIR=/var/lib/stackleo/uploads
MEDIA_LOCAL_PUBLIC_URL_PATH=/uploads
