# StackLeo API — Production Environment Variables
#
# Copy to `.env.production` and fill in real values; never commit the
# real file (see .gitignore). Consumed via docker-compose.production.yml's
# `env_file: apps/api/.env.production`. Read
# docs/11_Deployment_DevOps/production-checklist.md before using this
# for a real deployment.

NODE_ENV=production
PORT=4000

# Real, managed Postgres/Redis instances — never the same ones staging
# or development use, and never with default/example credentials.
DATABASE_URL=postgresql://stackleo:CHANGE_ME@production-db-host:5432/stackleo_production
REDIS_URL=redis://production-redis-host:6379

# Generate real, distinct values — e.g. `openssl rand -hex 32`. Store
# these in a real secrets manager, not a checked-out file, once you have
# one available; see docs/06_Security/secrets-management.md and
# docs/07_DevOps/secrets-management.md.
JWT_ACCESS_SECRET=CHANGE_ME_PRODUCTION_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allow only the real production web/admin origins — never a wildcard.
CORS_ALLOWED_ORIGINS=https://stackleo.example,https://admin.stackleo.example

LOG_LEVEL=warn

# Media — local-disk storage (modules/media's LocalUploadProvider). No
# Cloudinary/S3 integration is implemented yet (see modules/media's doc
# comments), so this is the only real storage backend available even in
# production; point MEDIA_LOCAL_STORAGE_DIR at a persistent, durable
# volume mounted into the container, not ephemeral container storage.
MEDIA_LOCAL_STORAGE_DIR=/var/lib/stackleo/uploads
MEDIA_LOCAL_PUBLIC_URL_PATH=/uploads
