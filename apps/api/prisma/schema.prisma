// StackLeo API — Prisma schema
//
// Conventions:
//   - Primary key: `id String @id @default(cuid())`
//   - Timestamps:  `createdAt DateTime @default(now())`
//                  `updatedAt DateTime @updatedAt`
//   - Table names: snake_case via `@@map("table_name")`
//   - Field names: camelCase in Prisma, mapped to snake_case columns
//                  via `@map("column_name")` where they differ
//   - Enums:       PascalCase type, SCREAMING_SNAKE_CASE members
//
// Connection pooling: for serverless/edge deployments, add a pooled
// `DATABASE_URL` (e.g. via PgBouncer) plus a `directUrl` pointing at the
// unpooled connection for migrations:
//   datasource db {
//     provider  = "postgresql"
//     url       = env("DATABASE_URL")
//     directUrl = env("DIRECT_URL")
//   }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The persisted user account. `roles` is a plain string array — see
/// src/modules/rbac's `Role` vocabulary — rather than a Postgres enum, so
/// adding a role never requires a migration.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  roles           String[]  @default(["member"])
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  profile                 UserProfile?
  preferences             UserPreferences?
  emailChangeTokens       EmailChangeToken[]

  @@map("users")
}

/// One issued refresh token per row — effectively a session. Never
/// stores the raw JWT: `tokenHash` is a SHA-256 digest, looked up in
/// constant-ish time on every /refresh call. `replacedById` records the
/// rotation chain (which token replaced this one), letting a reused,
/// already-rotated token be detected as a sign of theft.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash")
  replacedById String?   @map("replaced_by_id")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// A single-use, short-lived, hashed token proving control of the email
/// address on the associated user — never the raw token either.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/// A single-use, short-lived, hashed token authorizing one password
/// reset. Deliberately its own table rather than reusing
/// EmailVerificationToken — the two have different lifetimes and
/// single-use semantics that would otherwise have to be branched on a
/// shared `type` column.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Display/contact information and profile-visibility settings — kept
/// separate from `User` (identity + credentials) so profile edits never
/// touch the account/security fields, and so a user can exist without a
/// profile row until one is actually created (see the User API's
/// `getOwnProfile`, which upserts a default on first read).
model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?   @map("display_name")
  bio             String?
  phoneNumber     String?   @map("phone_number")
  avatarUrl       String?   @map("avatar_url")
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  /// Whether `GET /users/:id` exposes this profile to other users at
  /// all — see the User API's `getPublicProfile`.
  isPublic        Boolean   @default(true) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

/// App-level UX/notification settings — distinct from `UserProfile`:
/// this is how the user wants the product to behave for them, not how
/// they present themselves to others.
model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale               String   @default("en")
  timezone             String   @default("UTC")
  currency             String   @default("USD")
  theme                String   @default("system")
  marketingEmailsOptIn Boolean  @default(true) @map("marketing_emails_opt_in")
  orderUpdatesOptIn    Boolean  @default(true) @map("order_updates_opt_in")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

/// A single-use, short-lived, hashed token authorizing a pending change
/// of `User.email` to `newEmail`. Deliberately its own table rather than
/// reusing `modules/auth`'s `EmailVerificationToken` — that table (and
/// the module that owns it) is scoped to authentication concerns
/// (proving control of the email an account was *registered* with);
/// changing an already-verified account's email afterward is a user/
/// profile concern this module owns end to end, following the same
/// hashed-opaque-token pattern `modules/auth` already established.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String    @map("new_email")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_change_tokens")
}

/// The persisted product catalog entry. `status`/`visibility` are plain
/// strings (see `User.roles`'s doc comment for the same rationale) —
/// `modules/product`'s `PRODUCT_STATUSES`/`PRODUCT_VISIBILITIES` own the
/// actual vocabulary, so adding a value never requires a migration.
/// `categoryId` is a bare foreign-key-shaped field with no relation —
/// category CRUD is explicitly out of scope for the Product API: this
/// column exists so a future category module can attach to already-
/// tagged products without a data migration, not so this module can
/// join against it. Soft-deleted via `deletedAt` rather than a hard
/// `DELETE`, so a product's variants/specifications — and any future
/// order line referencing it — never dangle.
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sku         String   @unique
  /// Minor currency unit (e.g. cents for USD) — avoids floating-point
  /// rounding, matching `ProductVariant.price`.
  price       Int
  /// ISO 4217 currency code, e.g. "USD".
  currency    String
  status      String   @default("draft")
  visibility  String   @default("public")
  categoryId  String?  @map("category_id")
  tags        String[] @default([])

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String[] @default([]) @map("seo_keywords")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  variants       ProductVariant[]
  specifications ProductSpecification[]

  @@index([status])
  @@index([visibility])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}

/// A purchasable variation of a `Product` (e.g. a specific color/size
/// combination) — its own SKU, optional price/currency override (`null`
/// means "use the parent product's price"), and freeform `attributes`.
/// No stock/quantity field: inventory management is explicitly out of
/// scope for the Product API.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  name       String
  /// Variant-defining key/value pairs, e.g. `{"color": "Red", "size": "M"}`
  /// — freeform because the attribute set varies too much across a
  /// catalog to model as fixed columns without a category system, which
  /// is out of scope here.
  attributes Json
  price      Int?
  currency   String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

/// A single display specification row (e.g. "Material" -> "Aluminum")
/// attached to a `Product`. `sortOrder` controls display order on a
/// product page. Unique per `(productId, key)` — a product never has two
/// rows for the same spec key.
model ProductSpecification {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, key])
  @@index([productId])
  @@map("product_specifications")
}
