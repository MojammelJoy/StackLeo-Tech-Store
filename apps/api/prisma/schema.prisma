// StackLeo API — Prisma schema
//
// Conventions:
//   - Primary key: `id String @id @default(cuid())`
//   - Timestamps:  `createdAt DateTime @default(now())`
//                  `updatedAt DateTime @updatedAt`
//   - Table names: snake_case via `@@map("table_name")`
//   - Field names: camelCase in Prisma, mapped to snake_case columns
//                  via `@map("column_name")` where they differ
//   - Enums:       PascalCase type, SCREAMING_SNAKE_CASE members
//
// Connection pooling: for serverless/edge deployments, add a pooled
// `DATABASE_URL` (e.g. via PgBouncer) plus a `directUrl` pointing at the
// unpooled connection for migrations:
//   datasource db {
//     provider  = "postgresql"
//     url       = env("DATABASE_URL")
//     directUrl = env("DIRECT_URL")
//   }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The persisted user account. `roles` is a plain string array — see
/// src/modules/rbac's `Role` vocabulary — rather than a Postgres enum, so
/// adding a role never requires a migration.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  roles           String[]  @default(["member"])
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  profile                 UserProfile?
  preferences             UserPreferences?
  emailChangeTokens       EmailChangeToken[]

  @@map("users")
}

/// One issued refresh token per row — effectively a session. Never
/// stores the raw JWT: `tokenHash` is a SHA-256 digest, looked up in
/// constant-ish time on every /refresh call. `replacedById` records the
/// rotation chain (which token replaced this one), letting a reused,
/// already-rotated token be detected as a sign of theft.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash")
  replacedById String?   @map("replaced_by_id")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// A single-use, short-lived, hashed token proving control of the email
/// address on the associated user — never the raw token either.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/// A single-use, short-lived, hashed token authorizing one password
/// reset. Deliberately its own table rather than reusing
/// EmailVerificationToken — the two have different lifetimes and
/// single-use semantics that would otherwise have to be branched on a
/// shared `type` column.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Display/contact information and profile-visibility settings — kept
/// separate from `User` (identity + credentials) so profile edits never
/// touch the account/security fields, and so a user can exist without a
/// profile row until one is actually created (see the User API's
/// `getOwnProfile`, which upserts a default on first read).
model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?   @map("display_name")
  bio             String?
  phoneNumber     String?   @map("phone_number")
  avatarUrl       String?   @map("avatar_url")
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  /// Whether `GET /users/:id` exposes this profile to other users at
  /// all — see the User API's `getPublicProfile`.
  isPublic        Boolean   @default(true) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

/// App-level UX/notification settings — distinct from `UserProfile`:
/// this is how the user wants the product to behave for them, not how
/// they present themselves to others.
model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale               String   @default("en")
  timezone             String   @default("UTC")
  currency             String   @default("USD")
  theme                String   @default("system")
  marketingEmailsOptIn Boolean  @default(true) @map("marketing_emails_opt_in")
  orderUpdatesOptIn    Boolean  @default(true) @map("order_updates_opt_in")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

/// A single-use, short-lived, hashed token authorizing a pending change
/// of `User.email` to `newEmail`. Deliberately its own table rather than
/// reusing `modules/auth`'s `EmailVerificationToken` — that table (and
/// the module that owns it) is scoped to authentication concerns
/// (proving control of the email an account was *registered* with);
/// changing an already-verified account's email afterward is a user/
/// profile concern this module owns end to end, following the same
/// hashed-opaque-token pattern `modules/auth` already established.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String    @map("new_email")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_change_tokens")
}

/// The persisted product catalog entry. `status`/`visibility` are plain
/// strings (see `User.roles`'s doc comment for the same rationale) —
/// `modules/product`'s `PRODUCT_STATUSES`/`PRODUCT_VISIBILITIES` own the
/// actual vocabulary, so adding a value never requires a migration.
/// `categoryId` is a bare foreign-key-shaped field with no relation —
/// category CRUD is explicitly out of scope for the Product API: this
/// column exists so a future category module can attach to already-
/// tagged products without a data migration, not so this module can
/// join against it. Soft-deleted via `deletedAt` rather than a hard
/// `DELETE`, so a product's variants/specifications — and any future
/// order line referencing it — never dangle.
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sku         String   @unique
  /// Minor currency unit (e.g. cents for USD) — avoids floating-point
  /// rounding, matching `ProductVariant.price`.
  price       Int
  /// ISO 4217 currency code, e.g. "USD".
  currency    String
  status      String   @default("draft")
  visibility  String   @default("public")
  categoryId  String?  @map("category_id")
  /// Bare FK-shaped field, same convention as `categoryId` — no Prisma
  /// relation to `Brand` (mirrors why `categoryId` has none either).
  brandId     String?  @map("brand_id")
  tags        String[] @default([])

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String[] @default([]) @map("seo_keywords")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  variants       ProductVariant[]
  specifications ProductSpecification[]

  @@index([status])
  @@index([visibility])
  @@index([categoryId])
  @@index([brandId])
  @@index([deletedAt])
  @@map("products")
}

/// A purchasable variation of a `Product` (e.g. a specific color/size
/// combination) — its own SKU, optional price/currency override (`null`
/// means "use the parent product's price"), and freeform `attributes`.
/// No stock/quantity field: inventory management is explicitly out of
/// scope for the Product API.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  name       String
  /// Variant-defining key/value pairs, e.g. `{"color": "Red", "size": "M"}`
  /// — freeform because the attribute set varies too much across a
  /// catalog to model as fixed columns without a category system, which
  /// is out of scope here.
  attributes Json
  price      Int?
  currency   String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

/// A single display specification row (e.g. "Material" -> "Aluminum")
/// attached to a `Product`. `sortOrder` controls display order on a
/// product page. Unique per `(productId, key)` — a product never has two
/// rows for the same spec key.
model ProductSpecification {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, key])
  @@index([productId])
  @@map("product_specifications")
}

/// The persisted category catalog entry. `status`/`visibility` are
/// plain strings, mirroring `Product`'s own fields (see `Product`'s doc
/// comment for the shared rationale) — `modules/category`'s
/// `CATEGORY_STATUSES`/`CATEGORY_VISIBILITIES` own the actual
/// vocabulary. `parentId` self-references another `Category`, giving
/// categories a tree shape; `null` means "top-level." `onDelete:
/// SetNull` on that self-relation only matters for a hard delete, which
/// this module never performs through its own API (it soft-deletes via
/// `deletedAt`, cascaded to descendants in
/// `service/category.service.ts`) — it exists purely so the schema
/// itself stays valid without requiring every child to be deleted
/// before its parent could ever be hard-deleted by some other path.
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  status     String @default("draft")
  visibility String @default("public")
  /// Display order among sibling categories (same `parentId`) —
  /// ascending, ties broken by `name`. Never unique: gaps and ties are
  /// both fine, only relative order matters.
  sortOrder  Int    @default(0) @map("sort_order")

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String[] @default([]) @map("seo_keywords")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("categories")
}

/// The persisted brand catalog entry. `status`/`visibility` are plain
/// strings, mirroring `Product`/`Category` (see `Product`'s doc comment
/// for the shared rationale) — `modules/brand`'s `BRAND_STATUSES`/
/// `BRAND_VISIBILITIES` own the actual vocabulary. Unlike `Category`, a
/// `Brand` has no self-reference — brands are a flat list, not a
/// hierarchy.
model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  /// Logo *metadata* only — no file storage/upload infrastructure
  /// exists yet (out of scope for this API, same as `UserProfile`'s
  /// `avatarUrl`), so this is the already-uploaded asset's URL plus
  /// display metadata, never the image bytes themselves.
  logoUrl       String?   @map("logo_url")
  logoAltText   String?   @map("logo_alt_text")
  logoUpdatedAt DateTime? @map("logo_updated_at")

  websiteUrl String? @map("website_url")

  status     String @default("draft")
  visibility String @default("public")

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String[] @default([]) @map("seo_keywords")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("brands")
}

/// One SKU's stock record *at a specific warehouse* — `warehouseId` is a
/// bare foreign-key-shaped field, not a dependency on a warehouse
/// module (there is none yet; this field is what makes the model
/// already multi-warehouse-ready). `sku` mirrors `Product.sku` by
/// convention only — there is no enforced relationship between the two
/// models. Deliberately has no `availableQuantity` column:
/// `quantity - reservedQuantity` is a derived fact recomputed on every
/// read (see `modules/inventory`'s `getAvailableQuantity`), never
/// stored, so it can never drift out of sync with the two numbers it
/// comes from.
///
/// `version` is an optimistic-concurrency token, incremented on every
/// write that changes `quantity`/`reservedQuantity`/`status`. Every
/// such write goes through `InventoryPrismaRepository.applyStockChange`/
/// `transferStock`, which conditions its `UPDATE` on the caller's
/// last-read `version` — two concurrent stock mutations against the
/// same item can never silently overwrite one another; the loser's
/// write matches zero rows and is surfaced as a retryable conflict (see
/// `service/inventory.service.ts`'s `withOptimisticRetry`).
model InventoryItem {
  id                String @id @default(cuid())
  sku               String
  warehouseId       String @map("warehouse_id")
  quantity          Int    @default(0)
  reservedQuantity  Int    @default(0) @map("reserved_quantity")
  lowStockThreshold Int    @default(10) @map("low_stock_threshold")
  status            String @default("in_stock")
  version           Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@unique([sku, warehouseId])
  @@index([warehouseId])
  @@index([status])
  @@map("inventory_items")
}

/// One recorded stock movement — the audit-trail ledger of how an
/// item's quantity/reservedQuantity changed over time. `quantity` is
/// always a positive magnitude; direction is implied entirely by
/// `type`. Movements are append-only: nothing in this module ever
/// updates or deletes a row here.
model InventoryMovement {
  id              String        @id @default(cuid())
  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            String
  quantity        Int
  reason          String?
  /// Set only for `transfer_in`/`transfer_out` movements — the id of
  /// the `InventoryItem` on the *other* side of the transfer, so the
  /// ledger can reconstruct a transfer as one logical event spanning
  /// two items instead of two unrelated-looking rows.
  relatedItemId   String?       @map("related_item_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_movements")
}

/// The persisted metadata *about* an uploaded file — never the file
/// bytes themselves, which live wherever `provider` says (see
/// `modules/media`'s `UploadProvider`). `ownerType`/`ownerId` are bare
/// foreign-key-shaped fields, not relations — none of `Product`/
/// `Brand`/`Category`/`User` enforce a link back to this table either,
/// mirroring how `Product.categoryId` already relates to `Category`
/// only by convention.
///
/// `status` doubles as this model's soft-delete marker: `DELETED` is
/// already part of the upload lifecycle this foundation defined
/// (`PENDING` → `READY` | `FAILED`, or → `DELETED`), so
/// `service/media.service.ts`'s `delete`/`restore` just transition
/// `status` between `DELETED` and `READY` rather than introducing a
/// second, redundant `deletedAt` column alongside it.
model MediaAsset {
  id        String @id @default(cuid())
  fileName  String @map("file_name")
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")
  url       String

  /// Which storage backend persisted this file, and that backend's own
  /// reference to it (e.g. a local file key) — together enough for
  /// `UploadProvider.delete`/`getUrl` to act on this asset later
  /// without this module needing to know provider-specific details.
  provider    String
  providerRef String @map("provider_ref")

  purpose   String
  ownerType String? @map("owner_type")
  ownerId   String? @map("owner_id")

  altText String? @map("alt_text")

  /// Present for images; `null` for documents/unrecognized formats —
  /// see `mapper/image-dimension.utils.ts`.
  width           Int?
  height          Int?
  /// Present for videos only — never populated by this API (no video
  /// duration extraction is implemented), reserved for a future
  /// provider that reports it.
  durationSeconds Int? @map("duration_seconds")

  status String @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerType, ownerId])
  @@index([purpose])
  @@index([status])
  @@map("media_assets")
}

/// A shopper's cart — either guest-owned (`guestToken` set, `userId`
/// null) or user-owned (`userId` set, `guestToken` null); exactly one of
/// the two is ever set, enforced by `modules/cart`'s service layer, not
/// by this schema. `userId` is a bare foreign-key-shaped field, not a
/// relation — mirrors `Product.categoryId`'s convention (see that
/// model's doc comment): `modules/cart` stays decoupled from
/// `modules/user` at the Prisma-relation level, consistent with every
/// other cross-module reference in this schema. `status` is a plain
/// string for the same reason `Product`/`Category`/`Brand`/
/// `InventoryItem`/`MediaAsset` all are (see `Product`'s doc comment) —
/// `modules/cart`'s `CART_STATUSES` owns the vocabulary.
model Cart {
  id         String  @id @default(cuid())
  userId     String? @map("user_id")
  guestToken String? @unique @map("guest_token")
  currency   String  @default("USD")
  status     String  @default("active")

  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("carts")
}

/// A single product line within a `Cart`. `productId` is a bare
/// foreign-key-shaped field — no relation to `Product`, mirroring
/// `Cart.userId`'s convention above; `sku`/`unitPrice` are snapshotted
/// at add-time (see `modules/cart/types/cart-item.types.ts`'s `CartItem`
/// doc comment) — `modules/cart/service/cart.service.ts` recomputes
/// totals from the *current* product price at read time instead of
/// trusting this snapshot, so a price change elsewhere is still
/// reflected without this column needing to change. Unique per
/// `(cartId, productId)` — a cart never has two rows for the same
/// product; adding an already-present product increments this row's
/// `quantity` instead (see `CartPrismaRepository.addItem`).
model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  sku       String
  quantity  Int
  /// Minor currency unit (e.g. cents for USD), matching `Product.price`.
  unitPrice Int     @map("unit_price")
  selected  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

/// A shopper's "save for later" list — either guest-owned (`guestToken`
/// set, `userId` null) or user-owned (`userId` set, `guestToken` null),
/// mirroring `Cart`'s exact identity convention (see that model's doc
/// comment). `shareToken` is set only once `visibility` is `"shared"` —
/// the shape `modules/wishlist`'s future sharing feature would use;
/// nothing in the current API generates or serves one. `status`/
/// `visibility` are plain strings for the same reason every other
/// lifecycle-bearing model in this schema is (see `Product`'s doc
/// comment) — `modules/wishlist`'s `WISHLIST_STATUSES`/
/// `WISHLIST_VISIBILITIES` own the vocabulary.
model Wishlist {
  id         String  @id @default(cuid())
  userId     String? @map("user_id")
  guestToken String? @unique @map("guest_token")
  visibility String  @default("private")
  shareToken String? @unique @map("share_token")
  status     String  @default("active")

  items WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("wishlists")
}

/// A single product reference within a `Wishlist`. `productId` is a
/// bare foreign-key-shaped field — no relation to `Product`, mirroring
/// `CartItem.productId`'s convention; `sku`/`priceAtAdd` are
/// snapshotted at add-time (see
/// `modules/wishlist/types/wishlist-item.types.ts`'s `WishlistItem` doc
/// comment) so a future price-drop notification feature can compare
/// against it. Unique per `(wishlistId, productId)` — a product can
/// exist at most once per wishlist; adding an already-present product
/// is rejected rather than merged (there is no quantity concept here,
/// unlike `CartItem`).
model WishlistItem {
  id                   String   @id @default(cuid())
  wishlistId           String   @map("wishlist_id")
  wishlist             Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId            String   @map("product_id")
  sku                  String
  /// Minor currency unit (e.g. cents for USD), matching `Product.price`.
  priceAtAdd           Int      @map("price_at_add")
  notifyOnAvailability Boolean  @default(false) @map("notify_on_availability")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

/// A saved entry in a user's address book. Always user-owned — unlike
/// `Cart`/`Wishlist`, there is no guest concept here (an address book
/// only makes sense once there's an account to attach it to); `userId`
/// is still a bare foreign-key-shaped field with no relation, the same
/// convention every cross-module reference in this schema follows.
/// `type`/`label` are plain strings for the same reason every other
/// lifecycle-bearing model here is (see `Product`'s doc comment) —
/// `modules/address`'s `ADDRESS_TYPES`/`ADDRESS_LABELS` own the
/// vocabulary.
///
/// `isDefaultShipping`/`isDefaultBilling` are deliberately two
/// independent booleans, not the single `isDefault` flag the module's
/// foundation originally sketched: a `type: "both"` address can serve
/// as the default for one context without the other, and a single
/// shared flag can't represent that — changing just the default
/// shipping address would have had to blindly clear billing-default
/// status too whenever they happened to be the same row. Each is
/// enforced as "at most one `true` per user" by
/// `modules/address`'s `AddressPrismaRepository.setDefaultForUser`
/// (unset-then-set in one transaction), never by a database constraint
/// (a partial unique index would need raw SQL this schema style avoids
/// elsewhere).
///
/// `deletedAt` is this model's soft-delete marker, mirroring `Product`/
/// `Category`/`Brand`. A deleted address is never left as anyone's
/// default (see `AddressPrismaRepository.softDelete`, which always
/// clears both default flags in the same write).
model Address {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  label             String  @default("home")
  isDefaultShipping Boolean @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean @default(false) @map("is_default_billing")

  recipientName String  @map("recipient_name")
  phone         String?
  line1         String
  line2         String?
  city          String
  district      String?
  division      String
  postalCode    String  @map("postal_code")
  /// ISO 3166-1 alpha-2, e.g. "US", "BD".
  country       String

  /// Future support — see `modules/address`'s `ShippableAddress`
  /// interface. Nothing in this API geocodes an address or uses these
  /// for a real shipping calculation.
  latitude  Float?
  longitude Float?

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}
