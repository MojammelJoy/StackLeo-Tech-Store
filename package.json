{
  "name": "stackleo-tech-store",
  "version": "0.1.0",
  "private": true,
  "description": "StackLeo Tech Store — Everything Tech, One Marketplace. Enterprise e-commerce monorepo.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . --config eslint.config.js",
    "lint:fix": "eslint . --config eslint.config.js --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b tsconfig.json",
    "typecheck:watch": "tsc -b tsconfig.json --watch",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "prisma": "pnpm --filter @stackleo/api exec prisma",
    "clean": "pnpm -r run clean && rimraf \"**/.turbo\" \"**/dist\" \"**/.next\" \"**/coverage\" --glob",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "rimraf": "^5.0.5"
  }
}
